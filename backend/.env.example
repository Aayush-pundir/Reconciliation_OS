APP_NAME=Recon OS
ENVIRONMENT=development
DEBUG=true

# Postgres in docker-compose; sqlite:///./recon_os.db works for zero-infra local dev
DATABASE_URL=postgresql+psycopg2://recon:recon@postgres:5432/recon_os

JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# inprocess = zero-infra thread pool (local dev) | celery = production worker pool
JOB_RUNNER=celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# local = filesystem under STORAGE_LOCAL_ROOT | s3 = S3-compatible object storage
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1

MAX_UPLOAD_MB=200
CORS_ORIGINS=["http://localhost:5173"]

SEED_ADMIN_EMAIL=admin@eroute.local
SEED_ADMIN_PASSWORD=ChangeMe123!
